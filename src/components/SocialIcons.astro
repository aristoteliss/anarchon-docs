// Replaces the theme's social icons. Links that share an icon (the two GitHub repos) are shown as one
// button with a dropdown instead of two identical icons. A link with a unique icon stays a plain icon.
import { Icon } from '@astrojs/starlight/components';
import config from 'virtual:starlight/user-config';

type Link = NonNullable<typeof config.social>[number];

const groups = new Map<string, Link[]>();
for (const link of config.social ?? []) {
  groups.set(link.icon, [...(groups.get(link.icon) ?? []), link]);
}

const menuLabels: Record<string, string> = {
  en: 'GitHub repositories',
  el: 'Αποθετήρια GitHub',
};
const lang = Astro.locals.starlightRoute.lang.split('-')[0];
const menuLabel = (icon: string) =>
  icon === 'github' ? (menuLabels[lang] ?? menuLabels.en) : icon;

// "https://github.com/owner/repo" -> "owner/repo"
const shortHref = (href: string) => {
  try {
    const url = new URL(href);
    return url.host === 'github.com' ? url.pathname.replace(/^\/|\/$/g, '') : url.host;
  } catch {
    return href;
  }
};
---

{
  [...groups].map(([icon, links]) =>
    links.length === 1 ? (
      <a href={links[0].href} rel="me" class="social-button" aria-label={links[0].label}>
        <Icon name={icon} size="1rem" color="currentColor" />
      </a>
    ) : (
      <details class="social-menu" data-social-menu>
        <summary class="social-button" aria-label={menuLabel(icon)} title={menuLabel(icon)}>
          <Icon name={icon} size="1rem" color="currentColor" />
          <svg class="chevron" viewBox="0 0 24 24" aria-hidden="true">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </summary>
        <ul class="social-menu-panel">
          {links.map((link) => (
            <li>
              <a href={link.href} rel="me">
                <Icon name={icon} size="1.125rem" color="currentColor" />
                <span>
                  <span class="item-label">{link.label}</span>
                  <span class="item-href">{shortHref(link.href)}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </details>
    ),
  )
}

<script>
  // Close open menus on outside click or Escape. Runs once; listeners live on the document.
  const menus = () => document.querySelectorAll<HTMLDetailsElement>('details[data-social-menu][open]');

  document.addEventListener('click', (event) => {
    for (const menu of menus()) {
      if (!menu.contains(event.target as Node)) menu.open = false;
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    for (const menu of menus()) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
</script>

<style>
  .social-button {
    display: flex;
    align-items: center;
    gap: 0.125rem;
    height: 2rem;
    min-width: 2rem;
    padding: 0.5rem;
    border-radius: 0.375rem;
    color: var(--sl-color-text);
    cursor: pointer;
    list-style: none;
    transition:
      background-color 150ms,
      transform 150ms;
  }

  .social-button::-webkit-details-marker {
    display: none;
  }

  .social-button:hover,
  .social-menu[open] > .social-button {
    background-color: color-mix(in srgb, var(--sl-color-gray-3) 25%, transparent);
  }

  .social-button:active {
    transform: scale(0.92);
  }

  .chevron {
    width: 0.75rem;
    height: 0.75rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.7;
    transition: transform 150ms;
  }

  .social-menu[open] .chevron {
    transform: rotate(180deg);
  }

  .social-menu {
    position: relative;
  }

  .social-menu-panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    z-index: 100;
    min-width: 15rem;
    margin: 0;
    padding: 0.375rem;
    list-style: none;
    background-color: var(--sl-color-bg);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.625rem;
    box-shadow: var(--sl-shadow-md);
  }

  /* On narrow screens the button sits at the bottom of the mobile sidebar with other controls to
     its right, so the menu opens upward and centered over the button to stay on screen. */
  @media (max-width: 47.99rem) {
    .social-menu-panel {
      top: auto;
      right: auto;
      bottom: calc(100% + 0.5rem);
      left: 50%;
      transform: translateX(-50%);
    }
  }

  .social-menu-panel a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.625rem;
    border-radius: 0.375rem;
    color: var(--sl-color-text);
    text-decoration: none;
  }

  .social-menu-panel a:hover,
  .social-menu-panel a:focus-visible {
    background-color: color-mix(in srgb, var(--sl-color-gray-3) 20%, transparent);
  }

  .social-menu-panel a > span {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .item-label {
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .item-href {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
</style>
